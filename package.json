{
  "name": "signalk-endurance",
  "version": "2.2.1",
  "description": "Vessel resource monitoring and passage readiness for Signal K",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk-webapp"
  ],
  "signalk": {
    "displayName": "Endurance",
    "appIcon": "./icon.png",
    "recommends": [
      "signalk-derived-data",
      "@meri-imperiumi/signalk-energy-predictor",
      "@meri-imperiumi/signalk-consumption-estimator",
      "@meri-imperiumi/signalk-logbook",
      "signalk-weather-router-plus",
      "@meri-imperiumi/signalk-passage-briefing"
    ]
  },
  "signalk-plugin-enabled-by-default": false,
  "files": [
    "index.js",
    "lib",
    "public",
    "README.md",
    "LICENSE",
    "docs",
    "icon.png"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCarns/signalk-endurance.git"
  },
  "homepage": "https://github.com/SCarns/signalk-endurance#readme",
  "bugs": {
    "url": "https://github.com/SCarns/signalk-endurance/issues"
  },
  "author": "SCarns",
  "publishConfig": {
    "tag": "latest"
  }
